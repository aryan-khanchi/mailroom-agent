# --- Server ---
PORT=8080
# --- Persistence (Turso - free, no card required) ---
# Leave unset for quick local testing: defaults to a local file
# (file:./data/mailroom.db). For production, create a free database at
# https://turso.tech and set both of these to what `turso db show <name>`
# gives you:
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Model provider: gemini | openai | anthropic | ollama | mock ---
# "mock" is only for the offline test suite; never use it in the deployed service.
MODEL_PROVIDER=gemini

# Google Gemini free tier (recommended: no card, no expiration; ~15 RPM /
# ~250,000 tokens/min / ~1,000 req/day on the Flash-Lite tier, comfortably
# covering this task's batched calls). Model names move fast - Google
# deprecates old ones for new API keys every few months, so if you get a
# 404 "no longer available to new users", check
# https://ai.google.dev/gemini-api/docs/latest-model for the current name.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Anthropic (paid - direct Anthropic API, not free)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (if MODEL_PROVIDER=ollama) - point this at wherever Ollama actually
# runs. If it's your home PC, this URL must be reachable from your deployed
# server, which is the reliability trade-off discussed in chat.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.2

# OpenAI-compatible endpoint (if MODEL_PROVIDER=openai)
#
# AI Pipe (aipipe.org) example - get your token at https://aipipe.org/login:
#   OPENAI_BASE_URL=https://aipipe.org/openai/v1        (direct OpenAI proxy - plain model names)
#   OPENAI_BASE_URL=https://aipipe.org/openrouter/v1    (OpenRouter proxy - provider-prefixed model names)
#   OPENAI_API_KEY=<your AI Pipe token>
#   OPENAI_MODEL=gpt-4.1-nano          (via /openai/v1)
#   OPENAI_MODEL=openai/gpt-4.1-nano   (via /openrouter/v1)
#
# Groq example (also free/no-card, but low TPM per call - see README):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.1-8b-instant
#   Recommended if using Groq: MODEL_CHUNK_SIZE=3 or 4 (its free tier is
#   ~6,000 tokens/minute on some models, easy to exceed with 10 dossiers
#   batched into one call).
OPENAI_BASE_URL=https://aipipe.org/openai/v1
OPENAI_API_KEY=your-aipipe-token
OPENAI_MODEL=gpt-4.1-nano

# --- Batching / timeouts ---
# Number of dossiers per single model call. Larger = fewer round trips
# (helps fit the 55s request budget) but bigger prompts and more damage if
# one call fails. 8-15 is a reasonable range.
MODEL_CHUNK_SIZE=10
MODEL_TIMEOUT_MS=20000
